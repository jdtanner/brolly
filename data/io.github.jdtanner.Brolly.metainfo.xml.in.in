<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2014 Giovanni Campagna; 2026 Brolly contributors -->
<component type="desktop-application">
  <id>@app_id@</id>
  <name>Brolly</name>
  <summary>Weather forecasts from the provider you choose</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <description>
    <p>
      Brolly shows current conditions and hourly and daily forecasts for your
      location or anywhere in the world, from the weather service you prefer.
    </p>
    <p>Choose where your forecasts come from:</p>
    <ul>
      <li>Open-Meteo, free with no account, with a choice of weather models</li>
      <li>Met Office DataHub site-specific forecasts (free API key)</li>
      <li>OpenWeatherMap One Call 3.0 (your own API key)</li>
      <li>libgweather, as used by GNOME Weather</li>
    </ul>
    <p>
      Your automatic location is shown by its real town or village name,
      and you can search for any town or village. When a provider forecasts
      for a nearby site, Brolly tells you which one. API keys are kept in
      your keyring.
    </p>
    <p>
      An optional GNOME Shell extension makes the calendar-menu weather use
      the same provider.
    </p>
    <p>Brolly is a fork of GNOME Weather and is not affiliated with GNOME.</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/jdtanner/brolly/main/data/screenshots/hourly.png</image>
      <caption>Hourly forecast</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/jdtanner/brolly/main/data/screenshots/daily.png</image>
      <caption>Daily forecast</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/jdtanner/brolly/main/data/screenshots/preferences.png</image>
      <caption>Choosing a weather provider</caption>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#f6d32d</color>
    <color type="primary" scheme_preference="dark">#1c4f8a</color>
  </branding>
  <launchable type="desktop-id">@app_id@.desktop</launchable>
  <url type="homepage">https://github.com/jdtanner/brolly</url>
  <url type="bugtracker">https://github.com/jdtanner/brolly/issues</url>
  <url type="vcs-browser">https://github.com/jdtanner/brolly</url>
  <translation type="gettext">@app_id@</translation>
  <releases>
    <release version="0.1.0" date="2026-11-25">
      <description>
        <p>First release of Brolly, based on GNOME Weather 50.</p>
        <ul>
          <li>Choose a weather provider: Open-Meteo, Met Office, OpenWeatherMap or libgweather</li>
          <li>Automatic location uses your real position and town name</li>
          <li>Search for any town or village</li>
          <li>Shows which forecast site a provider is using</li>
          <li>API keys stored in the keyring</li>
          <li>Companion GNOME Shell extension for the calendar-menu weather</li>
        </ul>
      </description>
    </release>
  </releases>

  <developer id="io.github.jdtanner">
    <name>jdtanner</name>
  </developer>

  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
</component>
